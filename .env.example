# Скопируйте в .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=meeting
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meeting_english
# Для локального запуска без Docker (pnpm dev) хост — localhost.
# В docker compose адрес задаётся автоматически (хост postgres).
DATABASE_URL=postgresql://meeting:change-me@localhost:5432/meeting_english

# Redis
REDIS_URL=redis://localhost:6379

# apps/web
# Порт web в docker compose
WEB_PORT=3000
# Адрес realtime-сервера, который видит браузер
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001

# apps/realtime
REALTIME_PORT=3001
# Разрешённый Origin для Socket.IO (адрес веб-приложения)
WEB_ORIGIN=http://localhost:3000
