# Скопируйте в .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=meeting
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meeting_english
# Для локального запуска без Docker (pnpm dev) хост — localhost.
# В docker compose адрес задаётся автоматически (хост postgres).
DATABASE_URL=postgresql://meeting:change-me@localhost:5432/meeting_english
# Отдельная БД для интеграционных тестов: тесты очищают все таблицы.
# Создать: docker compose exec postgres createdb -U meeting meeting_english_test
# Без переменной тесты с БД локально пропускаются (в CI она обязательна).
TEST_DATABASE_URL=postgresql://meeting:change-me@localhost:5432/meeting_english_test

# Redis
REDIS_URL=redis://localhost:6379

# apps/web
# Порт web в docker compose
WEB_PORT=3000
# Адрес realtime-сервера, который видит браузер
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
# Публичный адрес сайта — для ссылок-приглашений
APP_ORIGIN=http://localhost:3000
# Cookie сессии с флагом Secure: в продакшне всегда; локально по http — выключено.
# COOKIE_SECURE=true

# apps/realtime
REALTIME_PORT=3001
# Разрешённый Origin для Socket.IO (адрес веб-приложения)
WEB_ORIGIN=http://localhost:3000
